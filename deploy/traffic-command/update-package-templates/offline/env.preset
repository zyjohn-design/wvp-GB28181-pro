# 必填：宇视设备能够访问的本机IPv4地址。不能填写127.0.0.1。
SERVER_IP=27.10.170.1

# GB28181上级平台参数，需要与宇视侧保持一致。
SIP_PORT=8116
SIP_DOMAIN=4201000000
SIP_ID=42010000002002609171
SIP_PASSWORD=

# H5兼容入口。若宿主机现有服务已占用7860，请改为17860，
# 并把config/nginx-existing-location.conf加入现有Nginx。
H5_PUBLIC_PORT=17860

# 管理页面对外监听。务必用防火墙限制18080只允许可信管理网访问。
WVP_BIND_IP=0.0.0.0
WVP_WEB_PORT=18080

# 调试端口默认只监听宿主机127.0.0.1。
WVP_DEBUG_PORT=18978
ZLM_DEBUG_PORT=18081

# ZLMediaKit的HTTP媒体端口，MP4(FMP4)/HLS/TS/WebRTC的播放地址都用它，
# 也是WVP调用ZLM接口使用的端口。对外放行该端口后外部才能访问
# http://SERVER_IP:18082/rtp/xxx.live.mp4
# 注意：修改本值后必须同步修改 config/zlm/config.ini 中的 [http] port，
# 以及 config/nginx/wvp-web.conf.template 中 proxy_pass 的端口。
ZLM_HTTP_PORT=18082

# ZLMediaKit单端口RTP接收。TCP和UDP都需要放行。
MEDIA_RTP_PORT=10000
MEDIA_RTMP_PORT=10935
MEDIA_RTSP_PORT=5540

# 适配层可根据通道编号自动查询所属的下级平台，平台级联时建议留空。
# 只有需要固定到单一下级设备/平台时才填写其20位国标编号。
DEFAULT_GB_DEVICE_ID=
MAX_CHANNELS=4
PLAY_TIMEOUT_MS=45000

# 数据库密码，交付现场后按需更换。
MYSQL_ROOT_PASSWORD=5e7a348f2aeba506363b73838b64fa9169405717
MYSQL_WVP_PASSWORD=b6e0adcca787f7a532d734659029c7d08764b612
