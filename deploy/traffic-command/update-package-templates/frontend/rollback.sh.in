#!/usr/bin/env sh
set -eu

# 回滚到升级前的前端镜像。用法：./rollback.sh [部署目录]

DEPLOY_DIR=${1:-/opt/gb28181-h5}
RELEASE_ID='__RELEASE_ID__'

if ! command -v docker >/dev/null 2>&1; then
    echo "错误：未找到 docker。" >&2
    exit 1
fi
if [ ! -f "$DEPLOY_DIR/compose.yaml" ] || [ ! -x "$DEPLOY_DIR/compose.sh" ]; then
    echo "错误：$DEPLOY_DIR 不是有效的 traffic-command 部署目录。" >&2
    exit 1
fi

cd "$DEPLOY_DIR"
WEB_IMAGE=$(./compose.sh config --images | grep -F 'gb28181-wvp-web' | head -n 1)
if [ -z "$WEB_IMAGE" ]; then
    echo "错误：未能从 compose 中解析出前端镜像（gb28181-wvp-web）。" >&2
    exit 1
fi
WEB_REPO=${WEB_IMAGE%:*}
BACKUP_IMAGE="${WEB_REPO}:pre-${RELEASE_ID}"

if ! docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1; then
    echo "错误：未找到升级前的镜像 $BACKUP_IMAGE。" >&2
    exit 1
fi

docker tag "$BACKUP_IMAGE" "$WEB_IMAGE"
./compose.sh up -d --force-recreate polaris-wvp-web
./compose.sh ps polaris-wvp-web
echo "已回滚到升级前的前端镜像；地图配置目录 config/map 与现场数据均未修改。"
