#!/usr/bin/env sh
set -eu

# WVP 完整前端更新包（静态资源全量替换），一键升级。
# 用法：./upgrade.sh [部署目录]   默认 /opt/gb28181-h5

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEPLOY_DIR=${1:-/opt/gb28181-h5}
TARGET_ARCH='__TARGET_ARCH__'
RELEASE_ID='__RELEASE_ID__'

MAP_DIR="$DEPLOY_DIR/config/map"
MAP_MOUNT_LINE='      - ./config/map:/opt/dist/map:ro'
NGINX_ANCHOR='      - ./config/nginx/wvp-web.conf.template:/etc/nginx/templates/default.conf.template:ro'
FALLBACK_BASE_IMAGE='nginx:1.27-alpine'

if ! command -v docker >/dev/null 2>&1; then
    echo "错误：未找到 docker。" >&2
    exit 1
fi
if [ ! -f "$DEPLOY_DIR/compose.yaml" ] || [ ! -x "$DEPLOY_DIR/compose.sh" ]; then
    echo "错误：$DEPLOY_DIR 不是有效的 traffic-command 部署目录。" >&2
    exit 1
fi
if [ ! -f "$DEPLOY_DIR/.env" ]; then
    echo "错误：$DEPLOY_DIR/.env 不存在；不会使用 .env.example 代替现场配置。" >&2
    exit 1
fi

machine_arch=$(uname -m)
case "$TARGET_ARCH:$machine_arch" in
    amd64:x86_64|amd64:amd64|arm64:aarch64|arm64:arm64) ;;
    *)
        echo "错误：当前服务器架构为 $machine_arch，本包目标架构为 $TARGET_ARCH。" >&2
        exit 1
        ;;
esac

"$SCRIPT_DIR/verify.sh"

cd "$DEPLOY_DIR"

# 现场前端镜像引用直接从 compose 里读，不假设固定标签
WEB_IMAGE=$(./compose.sh config --images | grep -F 'gb28181-wvp-web' | head -n 1)
if [ -z "$WEB_IMAGE" ]; then
    echo "错误：未能从 compose 中解析出前端镜像（gb28181-wvp-web）。" >&2
    exit 1
fi
WEB_REPO=${WEB_IMAGE%:*}
BACKUP_IMAGE="${WEB_REPO}:pre-${RELEASE_ID}"
NEW_IMAGE="${WEB_REPO}:${RELEASE_ID}-${TARGET_ARCH}"
echo "现场前端镜像：$WEB_IMAGE"

echo "[1/5] 准备地图配置目录（只创建、不覆盖）..."
mkdir -p "$MAP_DIR"
if [ -z "$(ls -A "$MAP_DIR" 2>/dev/null || true)" ]; then
    cp -R "$SCRIPT_DIR/map/." "$MAP_DIR/"
    echo "  已用默认配置初始化 $MAP_DIR"
else
    echo "  $MAP_DIR 已有配置，保持现场配置不做覆盖。"
fi

echo "[2/5] 确认前端容器已挂载地图配置目录..."
if grep -Fq "/opt/dist/map" "$DEPLOY_DIR/compose.yaml"; then
    echo "  compose.yaml 已挂载 /opt/dist/map。"
else
    backup="$DEPLOY_DIR/compose.yaml.bak-$(date +%Y%m%d%H%M%S)"
    cp "$DEPLOY_DIR/compose.yaml" "$backup"
    if grep -Fq "$NGINX_ANCHOR" "$DEPLOY_DIR/compose.yaml"; then
        sed -i "s|$NGINX_ANCHOR|$NGINX_ANCHOR\n$MAP_MOUNT_LINE|" "$DEPLOY_DIR/compose.yaml"
        echo "  已在 polaris-wvp-web 增加 $MAP_MOUNT_LINE"
        echo "  原文件已备份：$(basename "$backup")"
    else
        echo "错误：compose.yaml 中未找到预期的 Nginx 模板挂载行，请手工在 polaris-wvp-web 的" >&2
        echo "volumes 下添加：$MAP_MOUNT_LINE" >&2
        exit 1
    fi
fi

echo "[3/5] 备份现场前端镜像..."
if docker image inspect "$WEB_IMAGE" >/dev/null 2>&1; then
    if ! docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1; then
        docker tag "$WEB_IMAGE" "$BACKUP_IMAGE"
    fi
    echo "  回滚镜像：$BACKUP_IMAGE"
else
    echo "  警告：未找到现场前端镜像，将使用 $FALLBACK_BASE_IMAGE 作为基础镜像构建。"
fi

echo "[4/5] 构建完整前端镜像（替换全部静态资源）..."
if docker image inspect "$WEB_IMAGE" >/dev/null 2>&1; then
    base_image="$WEB_IMAGE"
elif docker image inspect "$FALLBACK_BASE_IMAGE" >/dev/null 2>&1; then
    base_image="$FALLBACK_BASE_IMAGE"
else
    echo "  本地缺少 $FALLBACK_BASE_IMAGE，尝试拉取..."
    docker pull "$FALLBACK_BASE_IMAGE"
    base_image="$FALLBACK_BASE_IMAGE"
fi

docker build --pull=false \
    --build-arg "BASE_IMAGE=$base_image" \
    -f "$SCRIPT_DIR/docker/web.Dockerfile" \
    -t "$NEW_IMAGE" \
    "$SCRIPT_DIR"

docker tag "$NEW_IMAGE" "$WEB_IMAGE"

echo "[5/5] 重建前端容器..."
./compose.sh up -d --force-recreate polaris-wvp-web

attempt=0
while [ "$attempt" -lt 30 ]; do
    web_id=$(./compose.sh ps -q polaris-wvp-web)
    if [ -n "$web_id" ] && [ "$(docker inspect -f '{{.State.Running}}' "$web_id")" = "true" ]; then
        ./compose.sh ps polaris-wvp-web
        echo "前端升级完成（镜像 $NEW_IMAGE）。"
        echo
        echo "================ 需要你手工修改的配置 ================"
        echo "1. 地图服务地址：$MAP_DIR/himap-config-light.js 和 himap-config-dark.js"
        echo "   - HOSTNAME / gkmapHOSTNAME：现场 HiMap 服务地址（himap.js、himap.css 所在处）"
        echo "   - CENTERPOINT：地图中心经纬度     - INITLEVEL：初始级别"
        echo "   - solution：底图样式 id           - MINEMAPURL/domainUrl/spriteUrl：瓦片服务地址"
        echo "   - GEOSERVERURL：GeoServer 地址（不用 WMS 可忽略）"
        echo "2. 改完保存后刷新浏览器页面即生效，无需重新打包或重启容器。"
        echo "======================================================"
        echo "回滚命令：./rollback.sh $DEPLOY_DIR"
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
done

./compose.sh ps polaris-wvp-web
echo "错误：容器未在60秒内进入 running；请检查日志或执行 rollback.sh。" >&2
exit 1
