#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEPLOY_DIR=${1:-/opt/gb28181-h5}
TARGET_ARCH='__TARGET_ARCH__'
RELEASE_ID='__RELEASE_ID__'
BACKEND_RELEASE='__BACKEND_RELEASE__'
WEB_RELEASE='__WEB_RELEASE__'
BACKEND_BACKUP='__BACKEND_BACKUP__'
WEB_BACKUP='__WEB_BACKUP__'
READY_ATTEMPTS=${WVP_UPDATE_READY_ATTEMPTS:-60}
case "$READY_ATTEMPTS" in
    ''|*[!0-9]*) echo '错误：WVP_UPDATE_READY_ATTEMPTS必须为2至180的整数。' >&2; exit 1 ;;
esac
if [ "$READY_ATTEMPTS" -lt 2 ] || [ "$READY_ATTEMPTS" -gt 180 ]; then
    echo '错误：WVP_UPDATE_READY_ATTEMPTS必须为2至180的整数。' >&2
    exit 1
fi

"$SCRIPT_DIR/verify.sh"
. "$SCRIPT_DIR/update-common.sh"
prepare_deployment
validate_image "$BACKEND_CURRENT"
validate_image "$WEB_CURRENT"
check_nginx_template
echo "现场后端镜像：$BACKEND_CURRENT"
echo "现场前端镜像：$WEB_CURRENT"

# Record actual references so rollback restores this deployment's original tags.
if [ -d "$STATE_DIR" ]; then
    check_saved_references
    validate_image "$BACKEND_BACKUP"
    validate_image "$WEB_BACKUP"
else
    if docker image inspect "$BACKEND_BACKUP" >/dev/null 2>&1 || docker image inspect "$WEB_BACKUP" >/dev/null 2>&1; then
        echo '错误：回滚标签已存在但本部署没有升级记录；请使用新的发布版本，避免覆盖备份。' >&2
        exit 1
    fi
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$BACKEND_CURRENT" > "$STATE_DIR/backend-image"
    printf '%s\n' "$WEB_CURRENT" > "$STATE_DIR/web-image"
    docker tag "$BACKEND_CURRENT" "$BACKEND_BACKUP"
    docker tag "$WEB_CURRENT" "$WEB_BACKUP"
fi

echo '构建后端增量镜像（仅替换 wvp.jar）...'
docker build --pull=false --network=none --platform="linux/$TARGET_ARCH" \
    --build-arg "BASE_IMAGE=$BACKEND_CURRENT" \
    -f "$SCRIPT_DIR/docker/backend.Dockerfile" -t "$BACKEND_RELEASE" "$SCRIPT_DIR"

echo '构建前端增量镜像（仅替换静态资源）...'
docker build --pull=false --network=none --platform="linux/$TARGET_ARCH" \
    --build-arg "BASE_IMAGE=$WEB_CURRENT" \
    -f "$SCRIPT_DIR/docker/web.Dockerfile" -t "$WEB_RELEASE" "$SCRIPT_DIR"

install_nginx_template
docker tag "$BACKEND_RELEASE" "$BACKEND_CURRENT"
docker tag "$WEB_RELEASE" "$WEB_CURRENT"
./compose.sh up -d --no-deps --force-recreate polaris-wvp polaris-wvp-web

attempt=0
ready_count=0
echo '等待后台完成启动恢复，并通过前端Nginx检查就绪接口...'
while [ "$attempt" -lt "$READY_ATTEMPTS" ]; do
    backend_id=$(./compose.sh ps -q polaris-wvp)
    web_id=$(./compose.sh ps -q polaris-wvp-web)
    if [ -n "$backend_id" ] && [ -n "$web_id" ] && \
       [ "$(docker inspect -f '{{.State.Running}}' "$backend_id" 2>/dev/null || true)" = 'true' ] && \
       [ "$(docker inspect -f '{{.State.Running}}' "$web_id" 2>/dev/null || true)" = 'true' ]; then
        ready_response=$(docker exec "$web_id" sh -c \
            'wget -q -T 3 -O - http://127.0.0.1:8080/api/server/health/ready' 2>/dev/null || true)
        if [ "$ready_response" = '{"status":"UP"}' ]; then
            ready_count=$((ready_count + 1))
            if [ "$ready_count" -ge 2 ]; then
                ./compose.sh ps polaris-wvp polaris-wvp-web
                echo '增量升级完成。前后端就绪检查通过。现场 .env、数据库和业务数据均未修改。'
                exit 0
            fi
        else
            ready_count=0
        fi
    else
        ready_count=0
    fi
    attempt=$((attempt + 1))
    sleep 2
done
./compose.sh ps polaris-wvp polaris-wvp-web
./compose.sh logs --no-color --tail 200 polaris-wvp polaris-wvp-web || true
echo '错误：前后端就绪检查未通过，不能确认升级成功。请检查启动日志或执行 rollback.sh。' >&2
exit 1
