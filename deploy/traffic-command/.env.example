# 必填：宇视设备能够访问的本机IPv4地址。不能填写127.0.0.1。
SERVER_IP=192.168.1.100

# GB28181上级平台参数，需要与宇视侧保持一致。
SIP_PORT=8116
SIP_DOMAIN=3402000000
SIP_ID=34020000002000000001
SIP_PASSWORD=请修改为强密码

# H5兼容入口。若宿主机现有服务已占用7860，请改为17860，
# 并把config/nginx-existing-location.conf加入现有Nginx。
H5_PUBLIC_PORT=7860

# WVP管理页面默认只监听本机。远程管理建议使用SSH端口转发：
# ssh -L 18080:127.0.0.1:18080 用户名@服务器IP
WVP_BIND_IP=127.0.0.1
WVP_WEB_PORT=18080

# 调试端口默认只监听宿主机127.0.0.1。
WVP_DEBUG_PORT=18978
ZLM_DEBUG_PORT=18081

# ZLMediaKit单端口RTP接收。TCP和UDP都需要放行。
MEDIA_RTP_PORT=10000
MEDIA_RTMP_PORT=10935
MEDIA_RTSP_PORT=5540

# 适配层可根据通道编号自动查询所属的下级平台，平台级联时建议留空。
# 只有需要固定到单一下级设备/平台时才填写其20位国标编号。
DEFAULT_GB_DEVICE_ID=
MAX_CHANNELS=4
PLAY_TIMEOUT_MS=45000

# 数据库密码，生产部署前必须修改。
MYSQL_ROOT_PASSWORD=请修改Root数据库密码
MYSQL_WVP_PASSWORD=请修改WVP数据库密码
