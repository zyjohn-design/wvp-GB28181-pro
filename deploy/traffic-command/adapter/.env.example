# 适配服务监听端口
PORT=8088

# WVP-GB28181-pro 管理/API 地址
WVP_BASE_URL=http://127.0.0.1:18978

# WVP 后台创建的 API Key。生产环境不要提交到代码仓库。
WVP_API_KEY=请替换为WVP后台生成的API_KEY
WVP_AUTH_HEADER=api-key

# ZLMediaKit 的 HTTP 地址。开启媒体代理时，浏览器不会直接访问这个地址。
ZLM_BASE_URL=http://127.0.0.1:8080

# 平台级联时可以留空，适配层会从WVP目录自动发现通道所属的下级平台。
# 只有需要固定到单一设备/平台时才填写其20位国标编号。
DEFAULT_GB_DEVICE_ID=

# 通道映射文件
DEVICE_MAP_FILE=./config/device-map.json

# true：通过本服务代理 HTTP-FLV，推荐，可避免跨域和混合内容。
PROXY_MEDIA=true

# 单个 index.html 页面最多播放的通道数，与现有 index2.html 的四分屏一致。
MAX_CHANNELS=4

# 等待 WVP 点播返回的超时时间，需略大于 WVP 的 play-timeout。
PLAY_TIMEOUT_MS=45000
