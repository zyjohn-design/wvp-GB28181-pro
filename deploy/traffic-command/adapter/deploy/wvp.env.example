# 此文件对应 WVP-GB28181-pro 官方仓库 docker/.env 的核心配置示例。
# 所有“请修改”项都必须根据客户视频服务器实际网卡和国标规划填写。

MediaRtmp=10935
MediaRtsp=5540
MediaRtp=10000
WebHttp=8080
WebHttps=8081

# 浏览器、宇视设备均能访问的视频服务器 IP，不能写 127.0.0.1。
Stream_IP=请修改为视频服务器IP
SDP_IP=请修改为视频服务器IP

# WVP 作为上级国标平台提供给宇视设备注册的信息。
SIP_ShowIP=请修改为视频服务器IP
SIP_Port=8116
SIP_Domain=3402000000
SIP_Id=34020000002000000001
SIP_Password=请修改为强密码

RecordSip=false
RecordPushLive=false
